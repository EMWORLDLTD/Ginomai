{
  "name": "ginomia",
  "version": "2.4.0",
  "description": "Ginomia — The Word in Motion",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "electron:dev": "electron .",
    "server": "node server.js",
    "dev": "node scripts/dev-server.js",
    "test": "node --test tests/*.test.js",
    "dist": "node scripts/build-desktop.js",
    "dist:win": "node scripts/build-desktop.js",
    "dist:mac": "node scripts/build-desktop.js --mac",
    "dist:mac:intel": "node scripts/build-desktop.js --mac --arch x64",
    "dist:mac:apple": "node scripts/build-desktop.js --mac --arch arm64",
    "installer:preview": "electron electron/installer --preview",
    "dist:publish": "node scripts/build-desktop.js --publish",
    "build:desktop": "node scripts/build-desktop.js",
    "eval:detection": "node scripts/evaluate-detection.cjs",
    "build:semantic": "node scripts/semantic-build.mjs"
  },
  "build": {
    "appId": "com.ginomai.pro",
    "productName": "Ginomia",
    "copyright": "Copyright © 2026 Ginomia",
    "publish": [
      {
        "provider": "github",
        "owner": "EMWORLDLTD",
        "repo": "ginomai-pro"
      }
    ],
    "files": [
      "**/*",
      "!dist/*",
      "!release/*",
      "!installers/*",
      "!scratch/*",
      "!archive/*",
      "!.git/*",
      "!assets/semantic/models/Xenova/all-MiniLM-L6-v2/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "obs",
    "church",
    "worship",
    "bible",
    "lyrics",
    "vmix",
    "broadcast",
    "electron",
    "desktop"
  ],
  "author": "Ginomia Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^5.4.624"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.4"
    }
  }
}
